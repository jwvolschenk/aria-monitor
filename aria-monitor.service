[Unit]
Description=Aria Monitor — vLLM Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/repos/aria-monitor
ExecStart=/usr/bin/python3 %h/repos/aria-monitor/monitor.py
EnvironmentFile=%h/repos/aria-monitor/aria-monitor.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
